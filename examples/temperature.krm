(fn celsius_to_fahrenheit (c)
  (+ (* c 1.8) 32.0))

(fn fahrenheit_to_celsius (f)
  (/ (- f 32.0) 1.8))

(fn celsius_to_kelvin (c)
  (+ c 273.15))

(fn kelvin_to_celsius (k)
  (- k 273.15))

(print (celsius_to_fahrenheit 0.0))
(print (celsius_to_fahrenheit 100.0))
(print (celsius_to_fahrenheit (- 0.0 40.0)))

(print (fahrenheit_to_celsius 32.0))
(print (fahrenheit_to_celsius 212.0))

(print (celsius_to_kelvin 0.0))
(print (kelvin_to_celsius 0.0))
