(fn sum (n)
  (if (== n 0)
    0
    (+ n (sum (- n 1)))))

(fn sum_acc (n acc)
  (if (== n 0)
    acc
    (sum_acc (- n 1) (+ acc n))))

(fn sum_squares (n)
  (if (== n 0)
    0
    (+ (* n n) (sum_squares (- n 1)))))

(print (sum 10))
(print (sum_acc 10 0))
(print (sum 100))

(print (sum_squares 5))
(print (sum_squares 10))
