(fn add (x)
  (fn (y) (+ x y)))

(fn multiply (x)
  (fn (y) (* x y)))

(fn flip (f)
  (fn (x) (fn (y) (f y x))))

(let add5 (add 5))
(let add10 (add 10))
(let double (multiply 2))
(let triple (multiply 3))

(print (add5 3))
(print (add5 10))
(print (add10 7))

(print (double 6))
(print (triple 6))

(let sub_from_10 (flip add 10))
(print (sub_from_10 3))
